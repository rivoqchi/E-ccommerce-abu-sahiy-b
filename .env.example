NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# API o'zining base URL i (log, webhook, linklar) — majburiy
APP_URL=http://localhost:4000

# Frontend asosiy URL — majburiy
FRONTEND_URL=http://localhost:3000

# CORS — ver gul bilan bir nechta origin — majburiy
CORS_ORIGIN=http://localhost:3000,https://e-ccommerce-abu-sahiy-f.vercel.app

MONGODB_URI=mongodb://mongo:27017/ecommerce
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

THROTTLE_TTL=60
THROTTLE_LIMIT=100

CACHE_TTL_SECONDS=60
LOW_STOCK_THRESHOLD=5

# Telegram Mini App + Bot (BotFather token)
TELEGRAM_BOT_TOKEN=
# polling | webhook (bo'sh: production=webhook, else=polling)
TELEGRAM_BOT_MODE=
# Webhook secret (X-Telegram-Bot-Api-Secret-Token) — webhook rejimida tavsiya
TELEGRAM_BOT_WEBHOOK_SECRET=

# Mini App HTTPS URL (Telegram web_app — localhost ishlamaydi)
TELEGRAM_MINI_APP_URL=https://e-ccommerce-abu-sahiy-f.vercel.app
# Open Web auto-login link (shu backend Redis bilan bir xil frontend)
# Lokal: http://localhost:3000
# Prod (Vercel + onrender API): https://e-ccommerce-abu-sahiy-f.vercel.app
TELEGRAM_OPEN_WEB_URL=http://localhost:3000

# Telegram Gateway API — majburiy (URL)
TELEGRAM_GATEWAY_URL=https://gatewayapi.telegram.org
TELEGRAM_GATEWAY_TOKEN=
# Local/dev without real Gateway credits
GATEWAY_MOCK=true
GATEWAY_MOCK_CODE=123456

OTP_TTL_SECONDS=600
OTP_COOLDOWN_SECONDS=600
OTP_DAILY_LIMIT=10
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Bot username without @ (login sahifasidagi deep link uchun)
TELEGRAM_BOT_USERNAME=samipricebot

# Super Admin — shu raqam OTP bilan kirsa role=admin
SUPER_ADMIN_PHONE=+998901234567

# Cloudflare R2 (rasm/video storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
